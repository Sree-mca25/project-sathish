# Copy to .env for local development. On Vercel, set these in
# Project Settings -> Environment Variables instead (never commit .env).

# Local only. Vercel injects its own PORT.
PORT=3000

# production | development. Controls the `secure` session cookie flag.
NODE_ENV=development

# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Seeded as the first Super Admin by `npm run init-db`.
# ADMIN_PASSWORD must be at least 12 characters.
ADMIN_NAME=Sathish Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Neon Postgres. Use the POOLED connection string (host contains "-pooler")
# so serverless instances don't exhaust the connection limit.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
